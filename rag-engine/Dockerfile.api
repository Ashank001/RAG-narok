FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

# Strip Windows CRLF line endings from start.sh (created on Windows)
# Without this, every shell command in start.sh has a \r appended,
# causing Celery to fail silently when the container starts on Linux.
RUN sed -i 's/\r$//' start.sh && chmod +x start.sh

CMD ["sh", "start.sh"]