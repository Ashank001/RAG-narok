FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

RUN echo 'import os, threading, http.server\nclass H(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        self.send_response(200)\n        self.end_headers()\n        self.wfile.write(b"{\"status\":\"worker_ok\"}")\n    def log_message(self, *a): pass\nport = int(os.environ.get("PORT", 10000))\nprint(f"Health server on port {port}", flush=True)\nt = threading.Thread(target=lambda: http.server.HTTPServer(("0.0.0.0", port), H).serve_forever())\nt.daemon = True\nt.start()' > health_server.py

CMD ["sh", "-c", "python health_server.py & sleep 2 && celery -A worker worker --loglevel=info --pool=solo --concurrency=1"]